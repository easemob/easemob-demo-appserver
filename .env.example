# Easemob App Server Configuration

# === App Credentials (Required) ===
# Get these from Easemob Console (https://console.easemob.com)
APP_KEY=your_app_key
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret

# === Agora Credentials (Required for Voice/Video) ===
# Get these from Agora Console
AGORA_APP_ID=your_agora_app_id
AGORA_CERT=your_agora_cert

# === Database Configuration ===
DB_PASSWORD=123456

# === Docker Configuration ===
# Mirror for faster builds in China. 
# Options: registry.cn-hangzhou.aliyuncs.com (Aliyun), docker.io (Official), etc.
DOCKER_MIRROR=registry.cn-hangzhou.aliyuncs.com

# === Optional Overrides ===
# BASE_HTTP_URI=http://a1.easemob.com
# INTRANET_BASE_HTTPS_URI=https://a1.easemob.com
